{
  "name": "lumiko-store",
  "version": "1.0.0",
  "description": "LUMIKO - Tienda online de juguetes domotizados y lamparas inteligentes de anime",
  "private": true,
  "scripts": {
    "start": "ng serve --configuration development --port 4200",
    "prebuild": "npm run catalog:export",
    "build": "ng build --configuration production",
    "prebuild:dev": "npm run catalog:export",
    "build:dev": "ng build --configuration development",
    "serve:dist": "npx http-server dist/lumiko -p 8080 -c-1",
    "catalog:build": "node tools/generate-catalog.js",
    "catalog:export": "node tools/export-catalog.js",
    "catalog:snapshot": "npm run catalog:build && npm run catalog:export",
    "verify:backend": "node tools/verify-backend.js",
    "functions:serve": "npx netlify dev"
  },
  "dependencies": {
    "@angular/animations": "~12.2.17",
    "@angular/common": "~12.2.17",
    "@angular/compiler": "~12.2.17",
    "@angular/core": "~12.2.17",
    "@angular/forms": "~12.2.17",
    "@angular/platform-browser": "~12.2.17",
    "@angular/platform-browser-dynamic": "~12.2.17",
    "@angular/router": "~12.2.17",
    "rxjs": "~6.6.7",
    "stripe": "^23.0.1",
    "tslib": "^2.3.1",
    "zone.js": "~0.11.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~12.2.17",
    "@angular/cli": "~12.2.17",
    "@angular/compiler-cli": "~12.2.17",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.1",
    "typescript": "~4.3.5"
  }
}
