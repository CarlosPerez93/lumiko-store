// Angular 12 (webpack 5.52) usa md4 y necesita el proveedor legacy de OpenSSL en Node 17+.
// Se aplica solo a los scripts de npm, no a tu shell.
node-options=--openssl-legacy-provider

// Angular 12 declara tailwindcss ^2 como peer opcional; mantenemos Tailwind 3.
legacy-peer-deps=true
audit=false
fund=false
