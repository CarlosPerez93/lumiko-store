# Variables de entorno de LUMIKO
#
# Este fichero es una plantilla: NO contiene secretos reales y no debe rellenarse
# en el repositorio. En producción se definen en Netlify
# (Site settings -> Environment variables). En local, copia a `.env` y usa
# `npx netlify dev` para que las Functions las reciban.

# --- Pasarela de pago (Stripe) ---------------------------------------------
# Clave secreta del modo test o live. Nunca se expone al navegador.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de firma del endpoint de webhook (Stripe -> Netlify).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Automatización de Despacho (Fulfillment) -------------------------------
# URL opcional de webhook externo (Zapier, Make, n8n, ERP, bot de compras)
# que recibe la orden estructurada con enlaces de compra y dirección del cliente.
# FULFILLMENT_WEBHOOK_URL=https://webhook.site/tu-id-o-endpoint-de-despacho

# --- Automatización de Redes Sociales (Marketing / Publicidad) --------------
# URL opcional de webhook externo (Make, Zapier, n8n, Metricool, Buffer)
# que recibe la campaña formateada (vídeo, imagen, copy, hashtags y fecha).
# SOCIAL_WEBHOOK_URL=https://hook.eu1.make.com/tu-webhook-de-redes

# --- Sitio ------------------------------------------------------------------
# URL pública canónica. Si no se define, la Function usa la URL del despliegue.
PUBLIC_SITE_URL=https://lumiko-store.netlify.app

# Etiqueta del entorno: production | preview | branch (la fija netlify.toml).
LUMIKO_ENV=development
